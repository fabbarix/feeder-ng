# UI guard modes (read by scripts/check-ui.sh). One line per rule: warn | fail.
# A WP that fixes a rule flips it to fail here. To flip only some folders first, add
#   <rule>.fail_paths=web/src/ui web/src/features/plan web/src/features/recipes web/src/features/import
# (space separated path prefixes): violations under them fail, the rest still warn.
native-ui=warn
native-ui.fail_paths=web/src/ui web/src/app web/src/features/recipes web/src/features/import web/src/features/cook web/src/features/board web/src/features/stock web/src/features/shop web/src/features/scan web/src/features/plan web/src/features/today web/src/features/settings web/src/features/ingredients web/src/features/products web/src/features/shops web/src/features/notifications web/src/features/signin
phosphor=fail
colour-literals=warn
colour-literals.fail_paths=web/src/ui web/src/app web/src/features/recipes web/src/features/import web/src/features/cook web/src/features/board web/src/features/stock web/src/features/shop web/src/features/scan web/src/features/plan web/src/features/today web/src/features/settings web/src/features/ingredients web/src/features/products web/src/features/shops web/src/features/notifications web/src/features/signin
class-hooks=warn
class-hooks.fail_paths=web/src/ui web/src/app web/src/features/recipes web/src/features/import web/src/features/cook web/src/features/board web/src/features/stock web/src/features/shop web/src/features/scan web/src/features/plan web/src/features/today web/src/features/settings web/src/features/ingredients web/src/features/products web/src/features/shops web/src/features/notifications web/src/features/signin
sizing=warn
sizing.fail_paths=web/src/ui web/src/app web/src/features/recipes web/src/features/import web/src/features/cook web/src/features/board web/src/features/stock web/src/features/shop web/src/features/scan web/src/features/plan web/src/features/today web/src/features/settings web/src/features/ingredients web/src/features/products web/src/features/shops web/src/features/notifications web/src/features/signin
glossary=warn
glossary.fail_paths=web/src/features/recipes web/src/features/import web/src/features/cook web/src/features/board web/src/features/stock web/src/features/shop web/src/features/scan web/src/features/plan web/src/features/today web/src/features/settings web/src/features/ingredients web/src/features/products web/src/features/shops web/src/features/notifications web/src/features/signin
native-search=warn
native-search.fail_paths=web/src/ui web/src/features/recipes web/src/features/import web/src/features/cook web/src/features/board web/src/features/stock web/src/features/shop web/src/features/scan web/src/features/plan web/src/features/today web/src/features/settings web/src/features/ingredients web/src/features/products web/src/features/shops web/src/features/notifications web/src/features/signin
back-link=fail
