raw-spacing.fail_paths=web/src/features/shop web/src/features/scan web/src/features/stock web/src/features/receipt web/src/features/ingredients web/src/features/products web/src/features/shops
media-width.fail_paths=web/src/features/shop web/src/features/scan web/src/features/stock web/src/features/receipt web/src/features/ingredients web/src/features/products web/src/features/shops
opacity-muting.fail_paths=web/src/features/shop web/src/features/scan web/src/features/stock web/src/features/receipt web/src/features/ingredients web/src/features/products web/src/features/shops
type-scale.fail_paths=web/src/features/shop web/src/features/scan web/src/features/stock web/src/features/receipt web/src/features/ingredients web/src/features/products web/src/features/shops
