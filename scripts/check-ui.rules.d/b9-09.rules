# B9-09 (plan section 3 and 6, the sweep by folder): Shop, Scan, Stock, Receipt and the catalogue are swept, so the
# sweep detectors fail there. fail_paths add up across rules files (scripts/check-ui.sh).
focus-ring.fail_paths=web/src/features/shop web/src/features/scan web/src/features/stock web/src/features/receipt web/src/features/ingredients web/src/features/products web/src/features/shops
