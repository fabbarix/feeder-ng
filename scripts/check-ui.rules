# UI guard modes (read by scripts/check-ui.sh). One line per rule: warn | fail.
# A WP that fixes a rule flips it to fail here. To flip only some folders first, add
#   <rule>.fail_paths=web/src/ui web/src/features/plan web/src/features/recipes web/src/features/import
# (space separated path prefixes): violations under them fail, the rest still warn.
native-ui=warn
native-ui.fail_paths=web/src/ui web/src/app web/src/features/recipes web/src/features/import
phosphor=fail
colour-literals=warn
colour-literals.fail_paths=web/src/ui web/src/app web/src/features/recipes web/src/features/import
class-hooks=warn
class-hooks.fail_paths=web/src/ui web/src/app web/src/features/recipes web/src/features/import
sizing=warn
sizing.fail_paths=web/src/ui web/src/app web/src/features/recipes web/src/features/import
glossary=warn
glossary.fail_paths=web/src/features/recipes web/src/features/import
native-search=warn
native-search.fail_paths=web/src/ui web/src/features/recipes web/src/features/import
